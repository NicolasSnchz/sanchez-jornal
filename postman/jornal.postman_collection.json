              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 API_ACCESO_DENEGADO', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().code).to.eql('API_ACCESO_DENEGADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud (Actuator)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 UP sin autenticacion', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Maestro",
      "item": [
        {
          "name": "Listar obras",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con obras del maestro', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('responde en menos de 1 s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear obra con datos invalidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 con los campos invalidos', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const fields = pm.response.json().fieldErrors.map(f => f.field);",
                  "  pm.expect(fields).to.include.members(['name', 'startDate']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear obra con fin en el pasado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bodega\",\n  \"address\": \"Calle 5 # 3-20\",\n  \"neighborhood\": \"Centro\",\n  \"city\": \"Cúcuta\",\n  \"startDate\": \"2025-01-06\",\n  \"estimatedEndDate\": \"2025-03-28\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 regla de negocio OBRA_FIN_PASADO', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().code).to.eql('OBRA_FIN_PASADO');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear obra",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bodega de materiales\",\n  \"address\": \"Calle 5 # 3-20\",\n  \"neighborhood\": \"Centro\",\n  \"city\": \"Cúcuta\",\n  \"startDate\": \"{{startDate}}\",\n  \"estimatedEndDate\": \"{{endDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const start = new Date(); start.setDate(start.getDate() + 7);",
                  "const end = new Date(); end.setDate(end.getDate() + 90);",
                  "pm.collectionVariables.set('startDate', start.toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('endDate', end.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con Location e id', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Location')).to.include('/api/obras/');",
                  "  pm.collectionVariables.set('siteId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir frente con jornal bajo el minimo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras/{{siteId}}/frentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras",
                "{{siteId}}",
                "frentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Descargue de material\",\n  \"requiredTrade\": \"HELPER\",\n  \"openings\": 2,\n  \"offeredDailyWage\": 40000,\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"workDays\": [\n    \"MONDAY\",\n    \"TUESDAY\",\n    \"WEDNESDAY\",\n    \"THURSDAY\",\n    \"FRIDAY\"\n  ],\n  \"startTime\": \"07:00\",\n  \"endTime\": \"16:00\",\n  \"lunchBreakMinutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 FRENTE_JORNAL_BAJO_MINIMO', () => {",
                  "  pm.response.to.have.status(422);",
                  "  pm.expect(pm.response.json().code).to.eql('FRENTE_JORNAL_BAJO_MINIMO');",
                  "  pm.expect(pm.response.json().message).to.include('$66.702');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir frente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/obras/{{siteId}}/frentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "obras",
                "{{siteId}}",
                "frentes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Descargue de material\",\n  \"requiredTrade\": \"HELPER\",\n  \"openings\": 2,\n  \"offeredDailyWage\": 75000,\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"workDays\": [\n    \"MONDAY\",\n    \"TUESDAY\",\n    \"WEDNESDAY\",\n    \"THURSDAY\",\n    \"FRIDAY\"\n  ],\n  \"startTime\": \"07:00\",\n  \"endTime\": \"16:00\",\n  \"lunchBreakMinutes\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 con el id del frente', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('frontId', pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Candidatos del frente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{foremanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/frentes/{{frontId}}/candidatos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "frentes",
                "{{frontId}}",
                "candidatos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con la elegibilidad de cada candidato', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const list = pm.response.json();",
                  "  pm.expect(list).to.be.an('array');",
                  "  list.forEach(c => pm.expect(c).to.have.property('issues'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Trabajador",
      "item": [
        {
          "name": "Mis asignaciones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mis-asignaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mis-asignaciones"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y una asignacion en curso', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const current = pm.response.json().find(a => a.status === 'IN_PROGRESS');",
                  "  pm.expect(current).to.not.be.undefined;",
                  "  pm.collectionVariables.set('assignmentId', current.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de mi asignacion",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mis-asignaciones/{{assignmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mis-asignaciones",
                "{{assignmentId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con saldo y jornadas', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const a = pm.response.json();",
                  "  pm.expect(a).to.have.property('balance');",
                  "  const pending = a.workDays.find(d => d.status === 'PENDING');",
                  "  pm.expect(pending).to.not.be.undefined;",
                  "  pm.collectionVariables.set('workDayId', pending.id);",
                  "});"
                ]
              }
            }
          ]
        },
