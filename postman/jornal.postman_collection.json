              "path": [
                "api",
                "jornadas",
                "{{workDayId}}",
                "confirmacion"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 jornada confirmada', () => pm.response.to.have.status(204));"
                ]
              }
