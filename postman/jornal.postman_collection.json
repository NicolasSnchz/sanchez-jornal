{
  "info": {
    "_postman_id": "00000000-0000-0000-0000-00000010e2a1",
    "name": "Jornal API",
    "description": "Pruebas de la API REST de Jornal: autenticacion JWT, roles, errores uniformes (ApiError) y flujo del maestro y del trabajador. Se ejecuta con Newman contra la aplicacion en perfil dev (datos de demostracion).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login maestro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{foremanEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y token Bearer', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.role).to.eql('FOREMAN');",
                  "  pm.collectionVariables.set('foremanToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login trabajador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{workerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 y rol WORKER', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().role).to.eql('WORKER');",
                  "  pm.collectionVariables.set('workerToken', pm.response.json().accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{foremanEmail}}\",\n  \"password\": \"clave-incorrecta-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 con error uniforme', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().code).to.eql('API_CREDENCIALES_INVALIDAS');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cuenta del token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con los datos de la cuenta', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().email).to.eql(pm.environment.get('workerEmail'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
