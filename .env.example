# Copia este archivo como .env (no se sube al repositorio). Para una prueba local
# sirven tal cual; para un servidor real cambia las dos claves.
DB_USERNAME=jornal
DB_PASSWORD=cambia-esta-clave
# Minimo 32 caracteres aleatorios. Por ejemplo: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres
# prod,demo = con datos de demostracion y Swagger. Solo prod = base vacia, sin Swagger.
SPRING_PROFILES_ACTIVE=prod,demo
